            <Style x:Key="ToggleButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#F0F0F0" />
                <Setter Property="TextColor" Value="#000000" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="FontAttributes" Value="None" />
            </Style>

            <Style x:Key="SelectedToggleButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#C49340" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontAttributes" Value="None" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <Style x:Key="MainStackLayout" TargetType="StackLayout">
                <Setter Property="Padding" Value="24,40,24,32" />
            </Style>

            <Style x:Key="HeaderLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
