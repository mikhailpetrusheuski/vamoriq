                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
            </Style>

            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
            </Style>

            <Style x:Key="Callout" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondary}}" />
            </Style>

            <Style x:Key="Subhead" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondary}}" />
            </Style>

            <Style x:Key="Footnote" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiary}}" />
            </Style>

            <Style x:Key="Caption1" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiary}}" />
            </Style>

            <Style x:Key="Caption2" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiary}}" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#C49340" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="None" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24,16" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="HeightRequest" Value="56" />
            </Style>

            <Style x:Key="AuthProviderButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="TextColor" Value="#C49340" />
                <Setter Property="BorderColor" Value="#C49340" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontAttributes" Value="None" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24,16" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="HeightRequest" Value="56" />
            </Style>

            <Style x:Key="TertiaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#000000" />
                <Setter Property="BorderColor" Value="Transparent" />
