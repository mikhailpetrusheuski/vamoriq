            <Style x:Key="SubtitleLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondary}}" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LineHeight" Value="1.3" />
            </Style>

            <Style x:Key="SectionTitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
            </Style>

            <Style x:Key="OptionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}"/>
            </Style>

            <Style x:Key="CustomRadioButton" TargetType="RadioButton">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0F0F0, Dark=#3A3A3C}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>

            <Style x:Key="ChipFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0F0F0, Dark=#3A3A3C}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

            <Style x:Key="ChipLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="RemoveChipButton" TargetType="Button">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
